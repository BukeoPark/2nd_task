# 이 파일을 .env 로 복사한 뒤 실제 키 값을 채운다. .env 는 커밋하지 않는다.

# --- 공공데이터포털 (data.go.kr): 지방행정 인허가, 상가업소정보 ---
DATA_GO_KR_KEY=

# --- 서울 열린데이터광장 (data.seoul.go.kr): 우리마을가게 상권분석, 생활인구 ---
SEOUL_OPENAPI_KEY=

# --- 한국부동산원 R-ONE (reb.or.kr/r-one): 상업용부동산 임대료/공실률 ---
REB_RONE_KEY=

# --- 카카오 (developers.kakao.com): 지도 SDK + 로컬 검색 ---
KAKAO_REST_API_KEY=
# 프론트엔드 지도 JS SDK 용 (도메인 등록 필요)
KAKAO_JS_APP_KEY=

# --- 네이버 검색 API (developers.naver.com, Client ID/Secret 방식, 선택) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Naver Cloud Platform (NCP, ncp_iam_ 형식) ---
NCP_ACCESS_KEY_ID=
NCP_SECRET_KEY=

# --- Anthropic (AI 창업 컨설팅 리포트) ---
ANTHROPIC_API_KEY=

# --- DB (Postgres/PostGIS 설치 후 사용, 미설정 시 파일 기반으로 동작) ---
DATABASE_URL=

# --- 나이스 교육정보 개방 포털 (open.neis.go.kr): 학원·교습소 운영이력 ---
NEIS_API_KEY=

# --- 배포 ---
# 브라우저에서 이 API 를 부를 앱 주소(JSON 배열). 기본은 로컬 개발 주소(5173)만 허용한다. 필요할 때만 주석을 풀고 값을 채운다(빈 값으로 두면 서버가 시작되지 않는다).
# CORS_ORIGINS=["https://app.example.com"]

# 단일 서버 배포(로컬 개발에서는 설정하지 않음)
# FRONTEND_DIST=/app/frontend/dist
# PORT=8000
# DATA_BUNDLE_URL=비공개_HTTPS_다운로드_주소
# DATA_BUNDLE_SHA256=분석_ZIP_SHA256
