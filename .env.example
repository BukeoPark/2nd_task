# 이 파일을 .env 로 복사한 뒤 실제 키 값을 채운다. .env 는 커밋하지 않는다.

# --- 공공데이터포털 (data.go.kr): 지방행정 인허가, 상가업소정보 ---
DATA_GO_KR_KEY=

# --- 서울 열린데이터광장 (data.seoul.go.kr): 우리마을가게 상권분석, 생활인구 ---
SEOUL_OPENAPI_KEY=

# --- 한국부동산원 R-ONE (reb.or.kr/r-one): 상업용부동산 임대료/공실률 ---
REB_RONE_KEY=

# --- 카카오 (developers.kakao.com): 지도 SDK + 로컬 검색 ---
KAKAO_REST_API_KEY=
# 프론트엔드 지도 JS SDK 용 (도메인 등록 필요)
KAKAO_JS_APP_KEY=

# --- 네이버 검색 API (developers.naver.com, Client ID/Secret 방식, 선택) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Naver Cloud Platform (NCP, ncp_iam_ 형식) ---
NCP_ACCESS_KEY_ID=
NCP_SECRET_KEY=

# --- Anthropic (AI 창업 컨설팅 리포트) ---
ANTHROPIC_API_KEY=

# --- DB (Postgres/PostGIS 설치 후 사용, 미설정 시 파일 기반으로 동작) ---
DATABASE_URL=

# --- Google Maps Platform (선택: 'Google 고객평가' 영역) ---
# 서버 전용: Places API (New) Text Search — 매장↔Google 장소 연결. IP 제한 권장, Place ID 만 저장.
GOOGLE_MAPS_SERVER_KEY=
# 무료 한도 보호용 호출 상한은 기본 일 150 / 분당 20. 바꾸려면 GOOGLE_TEXTSEARCH_DAILY_CAP=숫자 형태로 추가.
# 브라우저용 키(Maps JavaScript API + Places UI Kit)는 frontend/.env 의 VITE_GOOGLE_MAPS_BROWSER_KEY 에 넣는다(HTTP 리퍼러 제한 필수).

# --- 나이스 교육정보 개방 포털 (open.neis.go.kr): 학원·교습소 운영이력 ---
NEIS_API_KEY=
