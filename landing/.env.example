# landing/.env.local 로 복사해서 쓴다(빌드할 때 읽는다 — Next.js 는 NEXT_PUBLIC_ 변수를 빌드 결과에 박아 넣는다).

# 지도 앱 주소 — 랜딩의 '시작하기' 버튼이 ?mode=owner|founder 를 붙여 이 주소로 보낸다. 끝 슬래시는 있어도 없어도 된다.
# 비워 두면 로컬 개발 주소(http://localhost:5173)를 쓴다.
NEXT_PUBLIC_APP_URL=

# 이 랜딩 자체의 주소 — canonical·sitemap·공유 미리보기에 쓴다. http(s):// 로 시작해야 하고,
# 비워 두거나 localhost 면 검색 로봇이 색인하지 않게(robots.txt 가 전부 막음) 된다.
NEXT_PUBLIC_SITE_URL=
