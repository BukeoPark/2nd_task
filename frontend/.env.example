# frontend/.env 로 복사해서 값을 채운다. Vite 는 VITE_ 접두사가 붙은 변수만 브라우저에 노출한다.

# 카카오 디벨로퍼스 > 앱 설정 > 요약 정보 > 앱 키 > JavaScript 키
VITE_KAKAO_JS_APP_KEY=

# 백엔드 API 베이스 URL (uvicorn 기본 포트)
VITE_API_BASE_URL=http://localhost:8000

# Google Maps JavaScript API + Places UI Kit (선택: 'Google 고객평가' 영역).
# Cloud Console 에서 'Maps JavaScript API', 'Places UI Kit' 사용 설정 + HTTP 리퍼러 제한(localhost:5173 등) 필수.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# 개발 서버에서 주소만(쿼리 없이) 열면 보낼 랜딩페이지 주소(기본 http://localhost:3000). 비우면 보내지 않고 앱이 바로 열린다.
VITE_LANDING_URL=http://localhost:3000
